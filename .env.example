# Address people open, exactly as in the browser (https, no trailing slash).
PUBLIC_URL=https://math.example.com
# Only for the optional Caddy service: the domain part of PUBLIC_URL.
DOMAIN=math.example.com

# Emails allowed to create an account, comma separated. Leave empty to let anyone sign up.
ALLOWED_EMAILS=you@example.com

# Long random string; keeps people signed in across restarts and encrypts their Claude logins.
# Generate one with: openssl rand -hex 32   (changing it signs everyone out and forgets Claude logins)
SESSION_SECRET=
